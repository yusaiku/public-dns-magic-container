    {
      "id": 9,
      "type": "bargauge",
      "title": "Länder",
      "description": "Antwortbytes pro Sekunde nach Land. Jede Zeile zeigt die Flagge und den Landesnamen. Die Adresse und der abgefragte Name werden nicht gespeichert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
