{
  "uid": "dns-magic",
  "title": "DoH / DoT",
  "description": "Öffentliche Zähler bis zur Antwortzeit, dazu die Länder der Verbindungen. Die Antwortzeit gilt für Abfragen, die nicht im Cache lagen.",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "tags": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queries/s",
      "description": "Beantwortete DNS-Anfragen pro Sekunde.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dns_magic_queries_per_second",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "noValue": "Keine Daten",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache hits",
      "description": "Anteil der Anfragen, die aus dem Cache kamen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dns_magic_cache_ratio",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "noValue": "Keine Daten",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.15 },
              { "color": "green", "value": 0.30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SERVFAIL",
      "description": "Anteil der Antworten mit dem Status SERVFAIL.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dns_magic_servfail_ratio",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "noValue": "Keine Daten",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.03 },
              { "color": "red", "value": 0.08 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Slow > 1 s",
      "description": "Anteil der Anfragen, deren Auflösung länger als eine Sekunde dauerte.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dns_magic_slow_ratio",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "noValue": "Keine Daten",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Länder",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Länder",
      "description": "Antwortbytes pro Sekunde nach Land. Die Adresse und der abgefragte Name werden nicht gespeichert.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(dns_magic_country_bytes_per_second[$__range])",
          "legendFormat": "{{country}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": "OTHER", "renamePattern": "Andere" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 0,
          "min": 0,
          "noValue": "Keine Daten",
          "color": { "mode": "continuous-BlPu" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizHeight": 10,
        "maxVizHeight": 300,
        "namePlacement": "left",
        "sizing": "auto",
        "valueMode": "color"
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "panels": [],
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latency",
      "description": "Mittlere Auflösungszeit der Abfragen, die nicht im Cache lagen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dns_magic_latency_milliseconds",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "Keine Daten",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 250 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 26 },
      "options": {
        "mode": "markdown",
        "content": "Die Antwortzeit ist die Zeit des Resolvers für Abfragen, die nicht im Cache lagen. Die Länder zeigen, wohin die Antworten gingen, in Byte pro Sekunde. Gespeichert wird nur diese Länderzahl, nicht die Adresse und nicht der abgefragte Name. Mehrere Server mit derselben Storage Zone zählen zusammen, solange die Zone erreichbar ist. Sonst gelten die Zahlen nur für diesen Server. Sperren, verworfene Anfragen und Zeiten je Protokoll werden nicht gemessen.\n\nIP Geolocation by [DB-IP](https://db-ip.com/)."
      }
    }
  ]
}
