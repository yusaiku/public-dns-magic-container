        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(dns_magic_country_bytes_per_second[$__range])",
          "legendFormat": "{{country}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
