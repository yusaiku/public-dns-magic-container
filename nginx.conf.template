worker_processes 1;
pid /run/nginx.pid;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;

    server {
        listen 443 ssl;
        http2 on;
        server_name ${DOMAIN};

        ssl_certificate /etc/nginx/ssl/fullchain.cer;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        root /var/www/dns-magic;
        index index.html;

        location = /dns-query {
            proxy_pass http://127.0.0.1:4444;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
            client_max_body_size 64k;
        }

        location = /health {
            default_type text/plain;
            return 200 "OK\n";
        }

        location = /favicon.ico {
            types { }
            default_type image/svg+xml;
            add_header Cache-Control "public, max-age=86400";
            return 200 '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="4" fill="#1e4d3a"/><circle cx="16" cy="16" r="6" fill="none" stroke="#f4f1ea" stroke-width="2"/><circle cx="16" cy="16" r="2" fill="#f4f1ea"/></svg>';
        }

        location / {
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'" always;
            try_files $uri /index.html;
        }
    }

    server {
        listen 8080;
        server_name ${DOMAIN};

        location /health {
            default_type text/plain;
            return 200 "OK\n";
        }
    }
}
