worker_processes 1;
pid /run/nginx.pid;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    # Rate-limit messages include the requested URL. crit keeps startup
    # failures without writing DNS queries into the container log.
    error_log stderr crit;

    # DoH is one HTTP request per DNS query, so this is the per-client limit.
    limit_req_zone $binary_remote_addr zone=doh:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=web:10m rate=10r/s;
    # Grafana loads many files. This is looser than the info page and still bounded.
    limit_req_zone $binary_remote_addr zone=stats:10m rate=20r/s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
    limit_conn_zone $binary_remote_addr zone=perip:10m;
    limit_req_status 429;
    limit_conn_status 429;

    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 15s;
    keepalive_requests 100;

    server {
        listen 443 ssl;
        http2 on;
        http2_max_concurrent_streams 32;
        server_name ${DOMAIN};

        ssl_certificate /etc/nginx/ssl/fullchain.cer;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;

        root /var/www/dns-magic;
        index index.html;

        location = /dns-query {
            limit_req zone=doh burst=40 nodelay;
            limit_conn perip 16;
            proxy_pass http://127.0.0.1:4444;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_connect_timeout 2s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
            client_max_body_size 4k;
        }

        location = /health {
            default_type text/plain;
            return 200 "OK\n";
        }

        location = /favicon.ico {
            types { }
            default_type image/svg+xml;
            add_header Cache-Control "public, max-age=86400";
            return 200 '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="4" fill="#1e4d3a"/><circle cx="16" cy="16" r="6" fill="none" stroke="#f4f1ea" stroke-width="2"/><circle cx="16" cy="16" r="2" fill="#f4f1ea"/></svg>';
        }

        location = /doh.mobileconfig {
            limit_req zone=web burst=20 nodelay;
            limit_conn perip 8;
            types { }
            default_type application/x-apple-aspen-config;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header Cache-Control "no-store" always;
        }

        location = /stats.html {
            return 302 /stats/;
        }

        location = /stats {
            return 302 /stats/;
        }

        # Exact /stats/ opens the provisioned board. Everything under it is Grafana.
        # No CSP here: Grafana needs its own scripts and styles. The info page stays strict.
        location = /stats/ {
            return 302 /stats/d/dns-magic/doh-dot?orgId=1&refresh=1m&from=now-12h&to=now;
        }

        location /stats/ {
            limit_req zone=stats burst=60 nodelay;
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_send_timeout 60s;
            proxy_redirect off;
        }

        location = /dot.mobileconfig {
            limit_req zone=web burst=20 nodelay;
            limit_conn perip 8;
            types { }
            default_type application/x-apple-aspen-config;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header Cache-Control "no-store" always;
        }

        location / {
            limit_req zone=web burst=20 nodelay;
            limit_conn perip 8;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
            add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'" always;
            try_files $uri /index.html;
        }
    }

    server {
        listen 8080;
        server_name ${DOMAIN};

        location /health {
            default_type text/plain;
            return 200 "OK\n";
        }
    }

    # Prometheus scrapes this. It is not reachable from outside the container.
    server {
        listen 127.0.0.1:9100;
        server_name _;
        access_log off;

        location = /metrics {
            alias /var/lib/dns-magic/stats/metrics.prom;
            default_type text/plain;
            add_header Cache-Control "no-store";
        }

        location / {
            return 404;
        }
    }
}
